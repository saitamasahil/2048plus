+end
+
 function save.init(dir)
     if not dir or dir == "" or (love.system and love.system.getOS() == "Android") or _G.android_console then
         pcall(function()
@@ -769,4 +773,28 @@ function save.loadFullscreenTutorialSeen()
     return false
 end
 
+local CONTROLS_HELP_FILE = "controls_help.dat"
+
+function save.saveControlsHelp(mode)
+    local path = getFilePath(CONTROLS_HELP_FILE)
+    local file = io.open(path, "w")
+    if file then
+        file:write(mode)
+        file:close()
+    end
+end
+
+function save.loadControlsHelp()
+    local path = getFilePath(CONTROLS_HELP_FILE)
+    local file = io.open(path, "r")
+    if file then
+        local content = file:read("*all")
+        file:close()
+        if content and content ~= "" then
+            return content
+        end
+    end
+    return "auto"
+end
+
 return save
